/target
*.duckdb_extension
__pycache__/
*.pyc

# The extension-ci-tools recipe generates configure/ and assumes it is NOT tracked:
# a tracked extension_version.txt is never refreshed and stamps a stale version.
/configure/

# Generated by both build recipes: `make extension` writes
# build/subtoken.duckdb_extension, and the community recipe writes
# build/release/ with the raw cdylib beside it.
/build/
